# ─────────────────────────────────────────────────────────────────────────────
# FICHIER EXEMPLE — Ne jamais coller de vraies valeurs ici.
# Copier ce fichier en .env et remplir avec vos propres valeurs.
# En production, ces variables doivent être définies dans Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── BASE DE DONNÉES ──────────────────────────────────────────────────────────
# URL complète avec PgBouncer (pour l'app en production)
DATABASE_URL="postgresql://postgres.VOTRE_PROJECT_REF:VOTRE_MOT_DE_PASSE@aws-X-eu-west-X.pooler.supabase.com:6543/Ecole?schema=public&pgbouncer=true"

# URL directe (utilisée par Prisma migrate/push uniquement)
DIRECT_URL="postgresql://postgres.VOTRE_PROJECT_REF:VOTRE_MOT_DE_PASSE@db.VOTRE_PROJECT_REF.supabase.co:5432/Ecole?schema=public"

# ── JWT SÉCURITÉ ─────────────────────────────────────────────────────────────
# Générer une clé aléatoire forte (minimum 64 caractères) :
# openssl rand -hex 32
JWT_SECRET="REMPLACER_PAR_UNE_CLE_ALEATOIRE_DE_64_CHARS_MINIMUM"

# ── DOMAINE ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_ROOT_DOMAIN="saheledu.com"

# ── SUPABASE (FRONTEND — ANON KEY UNIQUEMENT) ────────────────────────────────
# La clé anon est publique par design (elle est restreinte par Row Level Security)
NEXT_PUBLIC_SUPABASE_URL="https://VOTRE_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="VOTRE_CLE_ANON_SUPABASE"

# ── RATE LIMITING (OPTIONNEL — Upstash Redis) ────────────────────────────────
# Si non défini, le système bascule sur un rate-limit en mémoire (moins robuste en multi-instance)
UPSTASH_REDIS_REST_URL="https://VOTRE_UPSTASH_URL.upstash.io"
UPSTASH_REDIS_REST_TOKEN="VOTRE_TOKEN_UPSTASH"

# ── EMAIL (OPTIONNEL — Notifications) ───────────────────────────────────────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@votre-ecole.ml"

# ── PAIEMENT ORANGE MONEY (OPTIONNEL) ───────────────────────────────────────
OM_AUTH_HEADER=""
OM_MERCHANT_KEY=""
OM_RETURN_URL="https://saheledu.com/parent/invoices"
OM_CANCEL_URL="https://saheledu.com/parent/invoices"
OM_NOTIF_URL="https://saheledu.com/api/finance/om-webhook"
