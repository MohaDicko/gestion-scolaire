# ==========================================
# ENVIRONNEMENT DE PRODUCTION SCHOOL ERP
# Renommez ce fichier en ".env" pour l'utiliser
# ==========================================

# 1. Base de données PostgreSQL
POSTGRES_USER=schooladmin_prod
POSTGRES_PASSWORD=ChoisissezUnMotDePasseTrèsFort!123
POSTGRES_DB=SchoolERP_Prod

# 2. Sécurité du Backend (JWT)
# Générez une chaîne longue et aléatoire d'au moins 32 caractères
JWT_SECRET_KEY=YOUR_SECURE_RANDOM_STRING_HERE_DO_NOT_COMMIT
JWT_ISSUER=SchoolERP_Issuer
JWT_AUDIENCE=SchoolERP_Users

# 3. Moteur URL et Proxy (Backend + Frontend)
# URL *externe* de votre API (Ce que le navigateur du client va appeler)
PUBLIC_API_URL=http://api.votre-domaine.com/api

# Origines autorisées pour le navigateur (CORS du Backend)
FRONTEND_CORS_URL=http://votre-domaine.com
